// Generated by the AI Coder NetBeans plugin (kiwi.ingenuity.netbeans.plugin.aicoder.ai.impl.pi.extension.PiExtensionGenerator)
// for ONE pi session. This file exists only while that session's process runs — the plugin deletes it when the
// session stops. It is written to a plugin-owned directory pi never auto-discovers, so a `pi` process started
// outside NetBeans never loads it.
//
// Only Node built-in modules (node:http, node:https, node:fs, node:path, node:os) and the global `fetch` are used —
// no npm dependencies, no build step. `fetch` is used only for the short MCP handshake (initialize, tools/list);
// tools/call and the review-hook POST use node:http/node:https directly with the process's own timeout handling,
// because Node's built-in fetch (undici) applies a default 300s headers/body timeout that would fail any plugin
// tool call — a build, an approval wait — that legitimately runs longer. See AICODER_CONFIG.toolCallTimeoutMs below.

/*__AICODER_CONFIG__*/

import * as http from "node:http";
import * as https from "node:https";
import * as path from "node:path";
import * as os from "node:os";

const HANDSHAKE_TIMEOUT_MS = AICODER_CONFIG.handshakeTimeoutMs;
const TOOL_CALL_TIMEOUT_MS = AICODER_CONFIG.toolCallTimeoutMs;

let mcpSessionId = null;

// ---- Small HTTP helpers ---------------------------------------------------------------------

function requestModuleFor(url) {
    return url.startsWith("https:") ? https : http;
}

/**
 * Parses an HTTP response body as either plain JSON or an SSE-framed JSON-RPC message
 * (`event: message\ndata: {...}\n\n`), per the MCP Streamable HTTP transport, which may answer either way. Every
 * call this extension makes is request/response (never a long-lived stream), so the last `data:` line's payload is
 * the whole message. The plugin's own MCP endpoint currently always answers plain JSON (McpHookServerUtil.sendJson),
 * so the JSON branch is the one actually exercised — the SSE branch is here for spec compliance / other servers.
 */
function parseHttpBody(contentType, text) {
    if (!text || text.length === 0) {
        return null;
    }
    if (contentType && contentType.indexOf("text/event-stream") >= 0) {
        let lastData = null;
        for (const rawLine of text.split(/\r?\n/)) {
            if (rawLine.startsWith("data:")) {
                lastData = rawLine.slice(5).trim();
            }
        }
        if (lastData === null) {
            throw new Error("SSE response had no data: line");
        }
        return JSON.parse(lastData);
    }
    return JSON.parse(text);
}

/**
 * POSTs JSON using node:http/node:https directly (never the global fetch — see the file header). The socket timeout
 * is disabled (req.setTimeout(0)); the only bound is `timeoutMs`, enforced by a manual timer that destroys the
 * request. `signal`, when supplied, aborts the request early (pi's own tool-call abort signal).
 */
function postJsonNoFetch(url, bodyObj, extraHeaders, timeoutMs, signal) {
    return new Promise((resolve, reject) => {
        const target = new URL(url);
        const body = JSON.stringify(bodyObj);
        const headers = Object.assign({
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
            "content-length": Buffer.byteLength(body)
        }, extraHeaders || {});

        const req = requestModuleFor(url).request({
            hostname: target.hostname,
            port: target.port,
            path: target.pathname + target.search,
            method: "POST",
            headers
        }, (res) => {
            const chunks = [];
            res.on("data", (c) => chunks.push(c));
            res.on("end", () => {
                const text = Buffer.concat(chunks).toString("utf8");
                let parsed;
                try {
                    parsed = parseHttpBody(res.headers["content-type"], text);
                }
                catch (e) {
                    reject(new Error("Could not parse response from " + url + ": " + e.message));
                    return;
                }
                resolve({ status: res.statusCode, headers: res.headers, body: parsed });
            });
        });

        // Never let the socket's own idle timeout cut this off — only our explicit timer (or the
        // caller's abort signal) may end the request. See the file header for why.
        req.setTimeout(0);
        req.on("error", (e) => reject(e));

        let timer = null;
        if (timeoutMs && timeoutMs > 0) {
            timer = setTimeout(() => {
                req.destroy(new Error("Request to " + url + " exceeded " + timeoutMs + " ms"));
            }, timeoutMs);
        }
        const cleanup = () => {
            if (timer) {
                clearTimeout(timer);
            }
        };
        req.on("close", cleanup);

        if (signal) {
            if (signal.aborted) {
                req.destroy(new Error("aborted"));
            }
            else {
                signal.addEventListener("abort", () => req.destroy(new Error("aborted")), { once: true });
            }
        }

        req.end(body);
    });
}

/**
 * POSTs JSON via the global `fetch`, for the short MCP handshake only (initialize, notifications/initialized,
 * tools/list — see the file header for why tools/call and the review hook use postJsonNoFetch instead). Sends
 * `extraHeaders` (the caller passes `mcpHeaders()` so the `Mcp-Session-Id` captured from `initialize`'s response
 * reaches every later handshake call too, not just tools/call).
 */
async function postJsonHandshake(url, bodyObj, extraHeaders) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), HANDSHAKE_TIMEOUT_MS);
    try {
        let res;
        try {
            res = await fetch(url, {
                method: "POST",
                headers: Object.assign({
                    "content-type": "application/json",
                    "accept": "application/json, text/event-stream"
                }, extraHeaders || {}),
                body: JSON.stringify(bodyObj),
                signal: controller.signal
            });
        }
        catch (e) {
            // fetch() throws a bare, unhelpful message ("fetch failed") for a connection refusal, DNS failure, etc
            // — before any HTTP response exists at all, unlike requireRpcResult's URL+status wording below, which
            // only applies once a response actually comes back. Rewrap with the URL and a plain-English hint so
            // the notify the caller shows is actionable instead of a cryptic Node network error.
            throw new Error("The IDE's MCP server at " + url + " could not be reached — pi will continue with "
                + "its own built-in tools only.");
        }
        const sessionHeader = res.headers.get("Mcp-Session-Id");
        if (sessionHeader) {
            mcpSessionId = sessionHeader;
        }
        if (res.status === 202) {
            return { status: 202, body: null };
        }
        const text = await res.text();
        const parsed = parseHttpBody(res.headers.get("content-type"), text);
        return { status: res.status, body: parsed };
    }
    finally {
        clearTimeout(timer);
    }
}

// ---- MCP Streamable-HTTP bridge -------------------------------------------------------------

let nextRpcId = 1;

function mcpHeaders() {
    return mcpSessionId ? { "Mcp-Session-Id": mcpSessionId } : {};
}

/**
 * A non-error JSON body alone isn't success — a proxy or misconfigured URL can return an HTTP error page containing
 * unrelated JSON, or the plugin's endpoint could 404 for a stale/wrong sessionId. Requires an HTTP 2xx status AND a
 * JSON-RPC result (no `.error`, a `.result` present). Throws with the URL and status code so the caller's
 * `ctx.ui.notify` message is actionable.
 */
function requireRpcResult(url, resp, methodLabel) {
    if (resp.status < 200 || resp.status >= 300) {
        throw new Error(methodLabel + " failed: " + url + " returned HTTP " + resp.status);
    }
    if (!resp.body || resp.body.error) {
        throw new Error(methodLabel + " failed: " + url + " returned HTTP " + resp.status + " but "
            + (resp.body && resp.body.error ? resp.body.error.message : "no JSON-RPC result"));
    }
    return resp.body.result;
}

/**
 * For fire-and-forget JSON-RPC notifications (`notifications/initialized`), which carry no id and get no JSON-RPC
 * response body — only an HTTP status to check (2xx, including the 202 Accepted the MCP spec calls for).
 */
function requireAccepted(url, resp, methodLabel) {
    if (resp.status < 200 || resp.status >= 300) {
        throw new Error(methodLabel + " failed: " + url + " returned HTTP " + resp.status);
    }
}

async function mcpInitialize() {
    const initResp = await postJsonHandshake(AICODER_CONFIG.mcpUrl, {
        jsonrpc: "2.0",
        id: nextRpcId++,
        method: "initialize",
        params: {
            protocolVersion: "2024-11-05",
            capabilities: {},
            clientInfo: { name: "aicoder-pi-extension", version: AICODER_CONFIG.pluginVersion }
        }
    }, mcpHeaders());
    requireRpcResult(AICODER_CONFIG.mcpUrl, initResp, "MCP initialize");
    // Notification (no id) — the server answers 202 and sends no body.
    const initializedResp = await postJsonHandshake(AICODER_CONFIG.mcpUrl, {
        jsonrpc: "2.0",
        method: "notifications/initialized"
    }, mcpHeaders());
    requireAccepted(AICODER_CONFIG.mcpUrl, initializedResp, "MCP notifications/initialized");
}

async function mcpListTools() {
    const tools = [];
    let cursor = undefined;
    const maxPages = 100;
    let page = 0;
    do {
        page++;
        if (page > maxPages) {
            throw new Error("MCP tools/list exceeded " + maxPages + " pages without the server ever stopping "
                + "sending a nextCursor — treating this as a misbehaving server rather than paging forever.");
        }
        const params = cursor ? { cursor } : {};
        const resp = await postJsonHandshake(AICODER_CONFIG.mcpUrl, {
            jsonrpc: "2.0",
            id: nextRpcId++,
            method: "tools/list",
            params
        }, mcpHeaders());
        const result = requireRpcResult(AICODER_CONFIG.mcpUrl, resp, "MCP tools/list") || {};
        (result.tools || []).forEach((t) => tools.push(t));
        cursor = result.nextCursor;
    } while (cursor);
    return tools;
}

/**
 * Calls `tools/call` for one plugin tool. Uses node:http directly (never fetch) with the 3-hour-class
 * TOOL_CALL_TIMEOUT_MS — a plugin tool call can legitimately run for a long time (an inline build, a test run, a
 * diff waiting on the user in the Accept/Reject panel). `signal` is pi's own per-call abort signal.
 */
async function mcpCallTool(name, args, signal) {
    const resp = await postJsonNoFetch(AICODER_CONFIG.mcpUrl, {
        jsonrpc: "2.0",
        id: nextRpcId++,
        method: "tools/call",
        params: { name, arguments: args || {} }
    }, mcpHeaders(), TOOL_CALL_TIMEOUT_MS, signal);
    // Same reasoning as the handshake: an HTTP 5xx/404/proxy error page whose JSON body happens to have no .error
    // field must not fall through to "result.result || {}" and be reported to pi as a successful empty tool call.
    const result = requireRpcResult(AICODER_CONFIG.mcpUrl, resp, "MCP tools/call for " + name) || {};
    const content = (result.content || []).map((c) => {
        if (c.type === "image") {
            return { type: "image", data: c.data, mimeType: c.mimeType };
        }
        return { type: "text", text: c.text || "" };
    });
    if (result.isError) {
        const message = content.filter((c) => c.type === "text").map((c) => c.text).join("\n") || (name + " failed");
        throw new Error(message);
    }
    return { content, details: result.details };
}

let typeBoxType = null;
let typeBoxLoadAttempted = false;

/**
 * pi's `registerTool` contract declares `parameters` as a TypeBox `TSchema`, but our tool schemas arrive from the
 * plugin's MCP `tools/list` as raw JSON Schema. A bare top-level `import "@sinclair/typebox"` would fail this whole
 * extension's load if the specifier doesn't resolve — this file lives in the plugin's own config dir, not inside
 * pi's own node_modules, so there is no guarantee TypeBox is resolvable from here. So: try a dynamic import of
 * "@sinclair/typebox", then "typebox", inside try/catch; if either resolves, its `Type.Unsafe(schema)` escape hatch
 * lets a raw JSON Schema object pass through as a TSchema. If neither resolves, the raw schema is passed unchanged —
 * pi's own tool registration accepts that in practice even though the declared type is stricter. Attempted once
 * (registerMcpTools only runs once per process, guarded by mcpToolsRegistrationStarted at session_start) and cached.
 */
async function loadTypeBox() {
    if (typeBoxLoadAttempted) {
        return typeBoxType;
    }
    typeBoxLoadAttempted = true;
    for (const specifier of ["@sinclair/typebox", "typebox"]) {
        try {
            const mod = await import(specifier);
            if (mod && mod.Type && typeof mod.Type.Unsafe === "function") {
                typeBoxType = mod.Type;
                break;
            }
        }
        catch (e) {
            // Specifier not resolvable from this extension's install location — try the next one, then fall back
            // to the raw schema below.
        }
    }
    return typeBoxType;
}

/**
 * `ctx` here is the `session_start` handler's context, threaded through so an unreachable server can still notify
 * the user — the `ExtensionAPI` object (`pi`) itself has no `.ctx` property; `ctx.ui` only exists as an event
 * handler's own argument (verified live against pi 0.85.1).
 *
 * <p>
 * pi does NOT wait for this handler to finish before starting a turn — a prompt sent while the handshake (initialize
 * / notifications/initialized / tools/list, all real HTTP round trips) is still in flight sees zero plugin tools,
 * silently. In the IDE this is the common case, not a rare one: the plugin spawns pi lazily and sends the user's
 * first prompt right away (live bug, Round 5). So this function emits a single machine-recognisable
 * `ctx.ui.notify` line at the END of every path — success or failure — as a readiness signal the Java side
 * (PiAiProcessManager) string-matches on to know registration is DONE and it is safe to send the first prompt.
 * KEEP BOTH STRINGS EXACTLY AS WRITTEN — the Java side matches on them verbatim:
 *   - success: "AI Coder MCP tools registered: " + <count of tools actually registered, excludedTools already
 *     subtracted>
 *   - failure: "AI Coder MCP tools unavailable: " + <reason> (unchanged from before this fix; the manager treats
 *     this the same as success for "stop waiting" purposes — it means no MORE tools are coming, not that some are)
 */
async function registerMcpTools(pi, ctx) {
    let tools;
    try {
        await mcpInitialize();
        tools = await mcpListTools();
    }
    catch (e) {
        if (ctx && ctx.ui && typeof ctx.ui.notify === "function") {
            ctx.ui.notify("AI Coder MCP tools unavailable: " + e.message);
        }
        return;
    }
    const Type = await loadTypeBox();
    const excluded = new Set(AICODER_CONFIG.excludedTools);
    let registeredCount = 0;
    for (const tool of tools) {
        if (excluded.has(tool.name)) {
            continue;
        }
        const inputSchema = tool.inputSchema || { type: "object", properties: {} };
        pi.registerTool({
            name: tool.name,
            label: tool.name,
            description: tool.description || "",
            // TypeBox's Type.Unsafe(schema) when it resolved (see loadTypeBox), else the raw JSON Schema unchanged.
            parameters: Type ? Type.Unsafe(inputSchema) : inputSchema,
            // Real signature verified live against pi 0.85.1: (toolCallId, params, signal, onUpdate, ctx) —
            // NOT (args, ctx). params is the actual tool arguments; signal is the plain AbortSignal.
            execute: async (toolCallId, params, signal, onUpdate, ctx) => mcpCallTool(tool.name, params, signal)
        });
        registeredCount++;
    }
    if (ctx && ctx.ui && typeof ctx.ui.notify === "function") {
        ctx.ui.notify("AI Coder MCP tools registered: " + registeredCount);
    }
}

// ---- Review gate: pi's own edit/write tools -> the existing PreToolUse hook -----------------

function resolvePath(rawPath, cwd) {
    if (!rawPath) {
        return rawPath;
    }
    let p = rawPath;
    if (p === "~" || p.startsWith("~/") || p.startsWith("~\\")) {
        p = path.join(os.homedir(), p.slice(1));
    }
    if (!path.isAbsolute(p)) {
        p = path.resolve(cwd || process.cwd(), p);
    }
    return p;
}

/**
 * Applies every edits[] entry to `text`, matching pi's own edit tool semantics exactly (verified live against pi
 * 0.85.1's installed dist/core/tools/edit-diff.js, relayed by Codex_1 2026-09-18): every oldText is matched against
 * the ORIGINAL text, never against a progressively-modified copy — pi's own tool contract explicitly forbids
 * overlapping/nested edits for this reason. Requires each oldText to be non-empty and occur exactly once in the
 * original text; rejects overlapping or nested edit ranges (adjacent ranges, where one's end equals the next's
 * start, are allowed — pi treats that as disjoint too). On success the final content is built by applying the
 * matched ranges in reverse original order, exactly like pi's own applyReplacements. On failure, returns a string
 * reason so the caller can fail closed without ever calling the hook. Deliberately exact-match only, no fuzzy
 * fallback (pi's tool has one) — that only makes this gate stricter than pi itself, never looser.
 */
function applyEditsInMemory(text, edits) {
    const matches = [];
    for (let i = 0; i < edits.length; i++) {
        const { oldText, newText } = edits[i];
        if (!oldText) {
            return { error: "edits[" + i + "].oldText must not be empty" };
        }
        const first = text.indexOf(oldText);
        if (first < 0) {
            return { error: "Could not find edits[" + i + "] in the file. The oldText must match exactly including all whitespace and newlines." };
        }
        const second = text.indexOf(oldText, first + oldText.length);
        if (second >= 0) {
            return { error: "edits[" + i + "] is not unique in the file. Each oldText must be unique — please provide more context to make it unique." };
        }
        matches.push({ editIndex: i, start: first, end: first + oldText.length, newText });
    }

    matches.sort((a, b) => a.start - b.start);
    for (let i = 1; i < matches.length; i++) {
        const previous = matches[i - 1];
        const current = matches[i];
        if (previous.end > current.start) {
            return {
                error: "edits[" + previous.editIndex + "] and edits[" + current.editIndex
                    + "] overlap. Merge them into one edit or target disjoint regions."
            };
        }
    }

    let result = text;
    for (let i = matches.length - 1; i >= 0; i--) {
        const m = matches[i];
        result = result.substring(0, m.start) + m.newText + result.substring(m.end);
    }
    return { content: result };
}

/**
 * Translates one gated pi tool call (`write`/`edit`) into a single Claude-shaped `Write` PreToolUse POST and returns
 * pi's `{block:true, reason}` result: `allow` -> undefined (pi's own tool proceeds), everything else -> block with
 * the hook's (possibly rewritten) reason. Fail-closed on any local or network problem.
 */
async function reviewGatedCall(call, ctx) {
    const fs = await import("node:fs/promises");
    const cwd = (ctx && ctx.cwd) || process.cwd();
    // event.input, not event.args — verified live against pi 0.85.1 (tool_call events carry {type, toolName,
    // toolCallId, input}; there is no .args field).
    const rawPath = call.input && call.input.path;
    if (!rawPath) {
        // pi always sends one in practice, but fail closed rather than resolving to cwd and sending
        // file_path: undefined to the hook if a future pi version or a misbehaving caller ever omits it.
        return { block: true, reason: "AI Coder cannot review this " + call.toolName + " call: no path was provided." };
    }
    const filePath = resolvePath(rawPath, cwd);

    let toolInput;
    if (call.toolName === "write") {
        toolInput = { file_path: filePath, content: (call.input && call.input.content) || "" };
    }
    else if (call.toolName === "edit") {
        let current;
        try {
            current = await fs.readFile(filePath, "utf8");
        }
        catch (e) {
            return { block: true, reason: "Edit not applied: could not read " + filePath + " (" + e.message + "). Re-read the file and retry." };
        }
        const edits = (call.input && call.input.edits) || [];
        const applied = applyEditsInMemory(current, edits);
        if (applied.error) {
            return { block: true, reason: "Edit not applied: " + applied.error + " in " + filePath + ". Re-read the file and retry." };
        }
        toolInput = { file_path: filePath, content: applied.content };
    }
    else {
        // Unreachable today (gatedTools is exactly ["edit","write"]), but fail closed like every other branch in
        // this function rather than letting a future third gated tool through unreviewed.
        return { block: true, reason: "AI Coder cannot review pi tool \"" + call.toolName + "\": unrecognised gated tool shape." };
    }

    const hookBody = {
        hook_event_name: "PreToolUse",
        session_id: AICODER_CONFIG.sessionId,
        tool_name: "Write",
        tool_input: toolInput
    };

    const maxAttempts = 5;
    for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        let resp;
        try {
            resp = await postJsonNoFetch(AICODER_CONFIG.hookUrl, hookBody, {}, TOOL_CALL_TIMEOUT_MS,
                ctx && ctx.signal);
        }
        catch (e) {
            return { block: true, reason: "Could not reach the IDE review panel: " + e.message };
        }
        const output = resp.body && resp.body.hookSpecificOutput;
        const decision = output && output.permissionDecision;
        if (decision === "allow") {
            return undefined;
        }
        if (decision === "deny") {
            let reason = output.permissionDecisionReason || "Change rejected.";
            // Keep this literal in sync with the Java side's McpHookServerUtil.APPLIED_BY_PLUGIN_PREFIX — nothing
            // cross-checks the two languages, so if that constant's text ever changes alone, an accepted write stops
            // being rewritten to the SUCCESS marker below and pi will think its own blocked write actually failed
            // and may re-apply it.
            if (reason.startsWith("Applied by NetBeans plugin")) {
                reason = "SUCCESS — the user accepted this change and the IDE applied it. It is NOT an error; "
                    + "do not retry. " + reason;
            }
            return { block: true, reason };
        }
        if (decision === "defer") {
            if (attempt < maxAttempts) {
                await new Promise((r) => setTimeout(r, 500 * attempt));
                continue;
            }
            return { block: true, reason: "The IDE was not ready to review this change — retry it." };
        }
        return { block: true, reason: "Could not reach the IDE review panel: unexpected response" };
    }
    return { block: true, reason: "The IDE was not ready to review this change — retry it." };
}

// ---- Extension entry point -------------------------------------------------------------------

export default function (pi) {
    const gated = new Set(AICODER_CONFIG.gatedTools);
    // session_start can fire more than once in the same process (e.g. session switch); the MCP handshake and tool
    // registration only need to happen once — guard against registering every tool a second time.
    let mcpToolsRegistrationStarted = false;

    pi.on("tool_call", async (call, ctx) => {
        if (!call || !gated.has(call.toolName)) {
            return undefined;
        }
        return reviewGatedCall(call, ctx);
    });

    pi.on("session_start", async (event, ctx) => {
        if (mcpToolsRegistrationStarted) {
            return;
        }
        mcpToolsRegistrationStarted = true;
        // Fire-and-forget: registerTool calls made once this resolves take effect live, per spec
        // ("pi.registerTool(...) at any time, live immediately"). ctx is threaded through so a failed
        // connection can still notify the user — see registerMcpTools's own doc comment. This outer .catch is a
        // safety net for an error OUTSIDE registerMcpTools's own try/catch (e.g. pi.registerTool itself throwing);
        // it emits the same "unavailable" readiness string registerMcpTools's own failure path does, so the Java
        // side still gets its stop-waiting signal even from this unexpected-error path.
        registerMcpTools(pi, ctx).catch((e) => {
            if (ctx && ctx.ui && typeof ctx.ui.notify === "function") {
                ctx.ui.notify("AI Coder MCP tools unavailable: " + e.message);
            }
        });
    });
}
